# apps/backend/.env — the stateless catalog/reading service. Copy to `.env`.
# All have dev defaults; set real values in production.

# Must match the root + apps/web values (see those files).
IMAGE_TOKEN_SECRET=
IMAGE_SIGN_SECRET=
API_KEY=
PORT=8787

# Optional — Cloudflare challenge solver (FlareSolverr) for CF-protected sources.
# e.g. http://localhost:8191  (run the flaresolverr Docker image)
FLARESOLVERR_URL=
# Optional — log format: "json" (prod) or "pretty" (dev).
LOG_FORMAT=
