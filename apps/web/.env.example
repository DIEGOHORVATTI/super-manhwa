# apps/web/.env.local — the Next.js app. Copy to `.env.local` and fill.
# Features degrade gracefully when their vars are unset (dbEnabled/r2Enabled/mpEnabled/
# emailEnabled), so set only what you need. [REQUIRED] = needed for that feature to work.

# ─────────────── Core / backend bridge ───────────────
# URL of the catalog/reading backend (apps/backend).
DELIVERY_SERVICE_URL=http://localhost:8787
# Shared X-API-KEY — must match apps/backend + root .env.
API_KEY=
# HMAC for cover signatures — MUST match apps/backend IMAGE_SIGN_SECRET.
IMAGE_SIGN_SECRET=
# Public canonical site URL (SEO/OG, absolute links).
SITE_URL=http://localhost:3000

# ─────────────── Database (Neon Postgres) — [REQUIRED for accounts/comments/learning] ───────────────
# Neon → project → Connection string (pooled). Then: cd apps/web && bun run db:push
DATABASE_URL=

# ─────────────── Auth (Better Auth) — [REQUIRED for login] ───────────────
# Session signing secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# App base URL (dev: http://localhost:3000 ; prod: your domain).
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (optional — the "Continue with Google" button only shows if set).
# Google Cloud Console → Credentials → OAuth client ID (Web). Redirect URI:
#   <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────── E-mail (Resend) — verification + password reset ───────────────
# resend.com → API Keys. Without it, action links are logged to the server instead.
RESEND_API_KEY=
# Sender from a domain verified in Resend.
MAIL_FROM=Super Manhwa <no-reply@your-domain>
# Where admin notifications go.
ADMIN_EMAIL=

# ─────────────── AniList (favourites sync + account linking) ───────────────
# anilist.co → Settings → Developer → Create client. Redirect URL: <SITE_URL>/auth/anilist
NEXT_PUBLIC_ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# ─────────────── Cloudflare R2 (image storage) — [REQUIRED for novel/user uploads + cache-on-read] ───────────────
# Cloudflare dashboard → R2.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=
# Public bucket domain / CDN base (R2 → bucket → Settings → Public access).
R2_PUBLIC_URL=
# R2 → Manage R2 API Tokens → Create (Object Read & Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─────────────── Payments (Mercado Pago) — donations + premium subscription ───────────────
# mercadopago.com.br/developers → your app → Credentials. TEST-... for sandbox.
MP_ACCESS_TOKEN=
# Optional — monthly premium price in BRL (default 14.90).
LEARN_PREMIUM_PRICE=14.90

# ─────────────── Cron (Vercel) — newsletter + scheduled publishing ───────────────
# Guards /api/cron/*. Generate: openssl rand -hex 32  (set the same value in Vercel)
CRON_SECRET=

# ─────────────── Community / flags ───────────────
# Discord invite link (the CTA card + footer icon only show if set).
NEXT_PUBLIC_DISCORD_URL=
# Set to "true" to show the newsletter signup (needs DATABASE_URL + RESEND_API_KEY).
NEXT_PUBLIC_NEWSLETTER_ENABLED=

# ─────────────── Ads (Adsterra) — optional ───────────────
NEXT_PUBLIC_ADSTERRA_BANNER_728x90=
NEXT_PUBLIC_ADSTERRA_BANNER_300x250=
NEXT_PUBLIC_ADSTERRA_NATIVE_SRC=
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK=
