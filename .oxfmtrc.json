{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "**/node_modules",
    "**/.next",
    "**/.vercel",
    "**/.wrangler",
    "**/data",
    "**/*.jsonl",
    "**/drizzle",
    "packages/extension/javascript",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml"
  ]
}
