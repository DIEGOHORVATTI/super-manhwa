{
  "name": "super-manhwa",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/client": "1.14.3",
      "@orpc/contract": "1.14.3",
      "@orpc/server": "1.14.3",
      "typescript": "5.5.3",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev:email": "cd packages/emails && bun run dev",
    "build": "cd apps/web && bun run build",
    "type-check": "cd apps/web && bunx tsc --noEmit",
    "format": "bunx oxfmt",
    "format:check": "bunx oxfmt --check",
    "lint": "bunx oxlint",
    "lint:fix": "bunx oxlint --fix",
    "ci": "bun run format:check && bun run lint && bun run type-check",
    "test": "cd apps/web && bun test",
    "test:web": "cd apps/web && bun test"
  }
}
