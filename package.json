{
  "name": "manga-search-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"cd apps/backend && bun run dev\" \"cd apps/frontend && bun run dev\"",
    "dev:web": "cd apps/frontend && bun run dev",
    "dev:api": "cd apps/backend && bun run dev",
    "start": "cd apps/backend && bun run start",
    "build": "cd apps/frontend && bun run build",
    "preview": "cd apps/frontend && bun run preview",
    "spike:mangadex": "bun packages/extension-runtime/spike/mangadex.ts",
    "spike:sources": "bun packages/extension-runtime/spike/sources.ts"
  },
  "dependencies": {
    "@packages/contracts": "workspace:*",
    "@packages/core": "workspace:*",
    "@packages/extension-runtime": "workspace:*",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.31.0",
    "@orpc/client": "^1.14.3",
    "@orpc/contract": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/openapi-client": "^1.14.3",
    "@orpc/react-query": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-router": "^1.170.8",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "quickjs-emscripten-core": "0.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
