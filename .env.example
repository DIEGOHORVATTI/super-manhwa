# Root .env — secrets shared by the catalog/reading backend and (some) the web app.
# Copy to `.env` and fill. All have dev defaults, so the app runs locally without them,
# but production MUST set real values.

# AES-256 key for opaque image/chapter tokens (id-store). Generate: openssl rand -hex 32
IMAGE_TOKEN_SECRET=
# HMAC secret for cover signatures. MUST be identical in apps/web/.env.local so the
# Next image proxy can verify covers signed by the backend. Generate: openssl rand -hex 32
IMAGE_SIGN_SECRET=
# Shared X-API-KEY guarding the backend; the web app sends it on every call.
# Generate: openssl rand -hex 24
API_KEY=
# Backend HTTP port.
PORT=8787
